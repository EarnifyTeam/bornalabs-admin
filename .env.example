# Supabase Credentials Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bornalabs?schema=public"

# App config
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication session secret
SESSION_SECRET="your-super-secret-session-key-change-in-production"

# SMTP Gateway Configuration
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your-smtp-password-or-apikey"
SMTP_FROM="noreply@bornalabs.com"
SMTP_FROM_NAME="BornaLabs Control Center"
